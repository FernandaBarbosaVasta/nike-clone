{% render 'vasta-collection-base' %}

<section class="vasta-c vasta-pills" aria-label="{{ section.settings.label | escape }}" {{ section.shopify_attributes }}>
  <ul class="vasta-pills__list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign target = block.settings.collection
        assign url = target.url | default: block.settings.url | default: '#'
        assign label = block.settings.label | default: target.title
        assign is_active = false
        if target != blank and collection != blank and target.handle == collection.handle
          assign is_active = true
        endif
      -%}
      <li class="vasta-pills__item" {{ block.shopify_attributes }}>
        <a
          class="vasta-pill{% if is_active %} is-active{% endif %}"
          href="{{ url }}"
          {% if is_active %}aria-current="page"{% endif %}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 96
              | image_tag: class: 'vasta-pill__img', width: 48, height: 48, loading: 'lazy', alt: ''
            }}
          {%- elsif block.settings.fallback != blank and block.settings.fallback != 'none' -%}
            {%- assign fallback_file = 'vasta-pill-' | append: block.settings.fallback -%}
            {%- if block.settings.fallback == 'snacks' or block.settings.fallback == 'hydration' -%}
              {%- assign fallback_file = fallback_file | append: '.png' -%}
            {%- else -%}
              {%- assign fallback_file = fallback_file | append: '.webp' -%}
            {%- endif -%}
            <img class="vasta-pill__img" src="{{ fallback_file | asset_url }}" width="48" height="48" loading="lazy" alt="">
          {%- endif -%}
          <span>{{ label }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Vasta | Category pills",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (if no collection)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Leave empty to use the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Default image",
          "info": "Used while no image is picked.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "supplements", "label": "Supplements" },
            { "value": "preworkout", "label": "Pre-workout" },
            { "value": "snacks", "label": "Snacks" },
            { "value": "hydration", "label": "Hydration" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vasta | Category pills",
      "blocks": [
        { "type": "pill", "settings": { "label": "Energy Drinks" } },
        { "type": "pill", "settings": { "label": "Supplements", "fallback": "supplements" } },
        { "type": "pill", "settings": { "label": "Pre-Workout", "fallback": "preworkout" } },
        { "type": "pill", "settings": { "label": "Snaks", "fallback": "snacks" } },
        { "type": "pill", "settings": { "label": "Hydration", "fallback": "hydration" } }
      ]
    }
  ]
}
{% endschema %}
