<div
  id="cart-drawer"
  class="cart-drawer"
  aria-hidden="true"
  style="--cart-drawer-bg: {{ section.settings.background }}; --cart-drawer-text: {{ section.settings.text_color }};"
>
  <div class="cart-drawer-overlay" data-cart-drawer-close tabindex="-1"></div>

  <aside class="cart-drawer-panel" role="dialog" aria-modal="true" aria-label="Cart">
    <div class="cart-drawer-header">
      <h2 class="cart-drawer-title">Cart{% unless cart.empty? %} ({{ cart.item_count }}){% endunless %} items</h2>
      <button type="button" class="cart-drawer-close" data-cart-drawer-close aria-label="Close cart">
        &times;
      </button>
    </div>

    <div class="cart-drawer-body">
      {% if cart.empty? %}
        <div class="cart-drawer-empty">
          <p>Your cart is empty</p>
          <a class="cart-drawer-empty-link" href="/collections/all">Continue shopping</a>
        </div>
      {% else %}
        <div class="cart-drawer-items">
          {% for item in cart.items %}
            <div class="cart-drawer-item">
              <a href="{{ item.url }}" class="cart-drawer-item-image">
                <img
                  width="90"
                  height="90"
                  loading="lazy"
                  src="{{ item.image | image_url: width: 180 }}"
                  alt="{{ item.title | escape }}"
                >
              </a>
              <div class="cart-drawer-item-details">
                <a href="{{ item.url }}" class="cart-drawer-item-title">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="cart-drawer-item-variant">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="cart-drawer-item-price">{{ item.final_line_price | money }}</p>
                <div class="cart-drawer-qty-control" data-qty-control>
                  <button type="button" class="cart-drawer-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
                  <span class="cart-drawer-qty-value">{{ item.quantity }}</span>
                  <input type="hidden" class="cart-drawer-qty-input" value="{{ item.quantity }}" data-line-key="{{ item.key }}">
                  <button type="button" class="cart-drawer-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="cart-drawer-remove" data-line-key="{{ item.key }}" aria-label="Remove {{ item.product.title | escape }}">
                  Remove
                </button>
              </div>
            </div>
          {% endfor %}
        </div>

        <p class="cart-drawer-total">Total: {{ cart.total_price | money }}</p>
      {% endif %}
    </div>

    <div class="cart-drawer-footer">
      <a href="{{ routes.cart_url }}" class="cart-drawer-go-to-cart">Go to cart</a>
    </div>
  </aside>
</div>

<style>
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .cart-drawer.is-open {
    pointer-events: auto;
  }

  .cart-drawer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer.is-open .cart-drawer-overlay {
    opacity: 1;
  }

  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    width: min(420px, 100vw);
    height: 100%;
    background: var(--cart-drawer-bg, #f4f4f4);
    color: var(--cart-drawer-text, #000);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .cart-drawer.is-open .cart-drawer-panel {
    transform: translateX(0);
  }

  .cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid #ddd;
  }

  .cart-drawer-title {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
  }

  .cart-drawer-close {
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: inherit;
  }

  .cart-drawer-close:hover {
    background: rgba(0, 0, 0, 0.08);
  }

  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
  }

  .cart-drawer-empty {
    text-align: center;
    padding: 40px 0;
  }

  .cart-drawer-empty p {
    margin: 0 0 16px;
    font-size: 16px;
    font-weight: 600;
  }

  .cart-drawer-empty-link {
    display: inline-block;
    padding: 12px 20px;
    border-radius: 8px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .cart-drawer-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cart-drawer-item {
    display: flex;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid #ddd;
  }

  .cart-drawer-item-image img {
    display: block;
    width: 90px;
    height: 90px;
    border-radius: 8px;
    object-fit: cover;
  }

  .cart-drawer-item-details {
    flex: 1;
    min-width: 0;
  }

  .cart-drawer-item-title {
    display: block;
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }

  .cart-drawer-item-title:hover {
    text-decoration: underline;
  }

  .cart-drawer-item-variant,
  .cart-drawer-item-price {
    margin: 0 0 6px;
    font-size: 13px;
  }

  .cart-drawer-item-price {
    font-weight: 600;
  }

  .cart-drawer-qty-control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0;
  }

  .cart-drawer-qty-btn {
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #fff;
    font-size: 16px;
    cursor: pointer;
  }

  .cart-drawer-qty-value {
    min-width: 18px;
    text-align: center;
    font-weight: 600;
    font-size: 14px;
  }

  .cart-drawer-remove {
    display: block;
    margin-top: 4px;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 13px;
    text-decoration: underline;
    cursor: pointer;
    color: inherit;
  }

  .cart-drawer-remove:hover {
    color: rgb(161, 26, 26);
  }

  .cart-drawer-total {
    margin: 20px 0 0;
    font-size: 20px;
    font-weight: 700;
  }

  .cart-drawer-footer {
    padding: 16px 20px 24px;
    border-top: 1px solid #ddd;
  }

  .cart-drawer-go-to-cart {
    display: block;
    width: 100%;
    padding: 14px 20px;
    border-radius: 8px;
    background-color:rgb(0, 49, 49);
    color: #fff;
    text-align: center;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    box-sizing: border-box;
  }

  .cart-drawer-go-to-cart:hover {
    background-color:rgb(18, 122, 117);
  }

  body.cart-drawer-open {
    overflow: hidden;
  }
</style>

<script>
  (function () {
    var drawer = document.getElementById('cart-drawer');
    if (!drawer) return;

    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    if (root.charAt(root.length - 1) !== '/') root += '/';
    var cartUpdateUrl = root + 'cart/update.js';

    function openDrawer() {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cart-drawer-open');
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cart-drawer-open');
    }

    document.querySelectorAll('[data-cart-drawer-open]').forEach(function (trigger) {
      trigger.addEventListener('click', function (event) {
        event.preventDefault();
        openDrawer();
      });
    });

    drawer.querySelectorAll('[data-cart-drawer-close]').forEach(function (el) {
      el.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents);
      }
      return (cents / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD'
      });
    }

    function updateTitleCount(count) {
      var title = drawer.querySelector('.cart-drawer-title');
      if (!title) return;
      title.textContent = count > 0 ? 'Cart (' + count + ')' : 'Cart';
    }

    function updateCartLine(lineKey, quantity) {
      var updates = {};
      updates[lineKey] = quantity;

      return fetch(cartUpdateUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ updates: updates })
      }).then(function (response) {
        if (!response.ok) throw new Error('Cart update failed');
        return response.json();
      });
    }

    function showEmptyDrawer() {
      var body = drawer.querySelector('.cart-drawer-body');
      if (!body) return;

      body.innerHTML =
        '<div class="cart-drawer-empty">' +
          '<p>Your cart is empty</p>' +
          '<a class="cart-drawer-empty-link" href="/collections/all">Continue shopping</a>' +
        '</div>';

      updateTitleCount(0);
    }

    function removeCartItemFromDom(button, cart) {
      var cartItem = button.closest('.cart-drawer-item');
      if (cartItem) cartItem.remove();

      var totalEl = drawer.querySelector('.cart-drawer-total');
      if (totalEl) {
        totalEl.textContent = 'Total: ' + formatMoney(cart.total_price);
      }

      updateTitleCount(cart.item_count);

      if (cart.item_count === 0) {
        showEmptyDrawer();
      }
    }

    function submitUpdate(control, nextQty) {
      var input = control.querySelector('.cart-drawer-qty-input');
      var display = control.querySelector('.cart-drawer-qty-value');
      var lineKey = input.getAttribute('data-line-key');

      input.value = nextQty;
      display.textContent = nextQty;

      updateCartLine(lineKey, nextQty)
        .then(function (cart) {
          if (nextQty === 0) {
            var removeBtn = control.closest('.cart-drawer-item-details').querySelector('.cart-drawer-remove');
            removeCartItemFromDom(removeBtn || control, cart);
            return;
          }

          var totalEl = drawer.querySelector('.cart-drawer-total');
          if (totalEl) {
            totalEl.textContent = 'Total: ' + formatMoney(cart.total_price);
          }

          updateTitleCount(cart.item_count);
        })
        .catch(function () {
          window.location.reload();
        });
    }

    drawer.querySelectorAll('[data-qty-control]').forEach(function (control) {
      var input = control.querySelector('.cart-drawer-qty-input');

      control.querySelector('[data-qty-minus]').addEventListener('click', function () {
        var qty = parseInt(input.value, 10) || 0;
        if (qty > 0) submitUpdate(control, qty - 1);
      });

      control.querySelector('[data-qty-plus]').addEventListener('click', function () {
        var qty = parseInt(input.value, 10) || 0;
        submitUpdate(control, qty + 1);
      });
    });

    drawer.querySelectorAll('.cart-drawer-remove[data-line-key]').forEach(function (button) {
      button.addEventListener('click', function () {
        var lineKey = button.getAttribute('data-line-key');
        if (!lineKey) return;

        button.disabled = true;

        updateCartLine(lineKey, 0)
          .then(function (cart) {
            removeCartItemFromDom(button, cart);
          })
          .catch(function () {
            button.disabled = false;
          });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "cart-drawer",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "cart-drawer"
    }
  ]
}
{% endschema %}
