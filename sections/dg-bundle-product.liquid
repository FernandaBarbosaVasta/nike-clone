<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
{{ 'dg-bundle.css' | asset_url | stylesheet_tag }}

{% if product != blank %}
  {% assign visual_qty = 0 %}
  {% assign priced_qty = 0 %}
  {% assign subtotal = 0 %}
  {% assign tier_count = 0 %}
  {% assign tier_hit = 0 %}
  {% assign best_min = -1 %}
  {% assign discount = 0 %}
  {% assign save_label = '' %}
  {% assign next_min = -1 %}
  {% assign next_discount = 0 %}

  {% for block in section.blocks %}
    {% if block.type == 'item' %}
      {% assign visual_qty = visual_qty | plus: block.settings.quantity %}
      {% if block.settings.product != blank and block.settings.quantity > 0 %}
        {% assign line_variant = block.settings.product.selected_or_first_available_variant %}
        {% assign line_total = line_variant.price | times: block.settings.quantity %}
        {% assign subtotal = subtotal | plus: line_total %}
        {% assign priced_qty = priced_qty | plus: block.settings.quantity %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% for block in section.blocks %}
    {% if block.type == 'tier' %}
      {% assign tier_count = tier_count | plus: 1 %}
      {% if visual_qty >= block.settings.min_qty %}
        {% assign tier_hit = tier_hit | plus: 1 %}
        {% if block.settings.min_qty >= best_min %}
          {% assign best_min = block.settings.min_qty %}
          {% assign discount = block.settings.discount | times: 100 %}
          {% assign save_label = block.settings.save_label %}
        {% endif %}
      {% endif %}
      {% if block.settings.min_qty > visual_qty %}
        {% if next_min == -1 or block.settings.min_qty < next_min %}
          {% assign next_min = block.settings.min_qty %}
          {% assign next_discount = block.settings.discount | times: 100 %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if subtotal <= 0 %}
    {% assign discount = 0 %}
  {% endif %}
  {% assign sale = subtotal | minus: discount %}
  {% if sale < 0 %}
    {% assign sale = 0 %}
  {% endif %}
  {% assign fill_pct = 0 %}
  {% if tier_count > 0 %}
    {% assign fill_pct = tier_hit | times: 100 | divided_by: tier_count %}
  {% endif %}
  {% if priced_qty > 0 %}
    {% assign can_add = 'yes' %}
  {% else %}
    {% assign can_add = 'no' %}
  {% endif %}
  {% assign sale_money = sale | money %}
  {% assign next_money = next_discount | money_without_trailing_zeros %}
  {% assign crumb = section.settings.breadcrumb %}
  {% if crumb == blank %}
    {% assign crumb = product.title %}
  {% endif %}
  {% assign heading = section.settings.heading %}
  {% if heading == blank %}
    {% assign heading = product.title %}
  {% endif %}
  {% assign review_count = product.metafields.reviews.rating_count.value %}
  {% assign review_rating = product.metafields.reviews.rating.value %}
  {% if section.settings.smaller_url != blank %}
    {% assign smaller_href = section.settings.smaller_url %}
  {% else %}
    {% assign smaller_href = routes.all_products_collection_url %}
  {% endif %}
  {% if product.images.size > 0 %}
    {% assign main_src = product.images.first | image_url: width: 1200 %}
    {% if product.images.first.alt != blank %}
      {% assign main_alt = product.images.first.alt %}
    {% else %}
      {% assign main_alt = product.title %}
    {% endif %}
  {% else %}
    {% assign main_src = 'dg-hero.webp' | asset_url | append: '&width=1132' %}
    {% assign main_alt = product.title %}
  {% endif %}

  <div
    class="dg-bundle"
    id="dg-bundle-{{ section.id }}"
    data-dg-bundle
  >
    <nav class="dg-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ section.settings.home_label }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ crumb }}</span>
    </nav>

    <div class="dg-bundle__grid">
      <div class="dg-bundle__media">
        <div class="dg-gallery">
          <div class="dg-gallery__stage">
            <img
              data-dg-main
              src="{{ main_src }}"
              alt="{{ main_alt | escape }}"
              width="566"
              height="610"
              fetchpriority="high"
            >
            <div class="dg-badges">
              {% for block in section.blocks %}
                {% if block.type == 'tier' and block.settings.image_badge != blank %}
                  <span>{{ block.settings.image_badge }}</span>
                {% endif %}
              {% endfor %}
            </div>
            <img
              class="dg-gallery__arrows"
              src="{{ 'dg-gallery-mark.svg' | asset_url }}"
              alt=""
              width="529"
              height="47"
            >
            <button type="button" class="dg-gallery__hit dg-gallery__hit--prev" data-dg-main-prev aria-label="{{ section.settings.prev_label }}">
              <span class="dg-sr">{{ section.settings.prev_label }}</span>
            </button>
            <button type="button" class="dg-gallery__hit dg-gallery__hit--next" data-dg-main-next aria-label="{{ section.settings.next_label }}">
              <span class="dg-sr">{{ section.settings.next_label }}</span>
            </button>
          </div>

          <div class="dg-thumbs">
            <button type="button" class="dg-nav" data-dg-prev aria-label="{{ section.settings.prev_label }}">
              <img src="{{ 'dg-icon-prev.svg' | asset_url }}" alt="" width="28" height="28">
            </button>
            <div class="dg-thumbs__track" data-dg-track>
              {% if product.images.size > 0 %}
                {% for image in product.images %}
                  {% assign thumb_alt = image.alt | default: product.title %}
                  <button
                    type="button"
                    class="dg-thumb{% if forloop.first %} is-active{% endif %}"
                    data-dg-thumb
                    data-full="{{ image | image_url: width: 1200 }}"
                    data-alt="{{ thumb_alt | escape }}"
                    aria-label="{{ thumb_alt | escape }}"
                  >
                    <img
                      src="{{ image | image_url: width: 164 }}"
                      alt=""
                      width="82"
                      height="82"
                      loading="lazy"
                    >
                  </button>
                {% endfor %}
              {% else %}
                {% assign fallback_thumbs = 'dg-hero.webp,dg-thumb-1.webp,dg-thumb-2.webp,dg-thumb-3.webp,dg-thumb-4.webp,dg-thumb-5.webp' | split: ',' %}
                {% for name in fallback_thumbs %}
                  <button
                    type="button"
                    class="dg-thumb{% if forloop.first %} is-active{% endif %}"
                    data-dg-thumb
                    data-full="{{ name | asset_url }}"
                    data-alt="{{ product.title | escape }}"
                    aria-label="{{ product.title | escape }}"
                  >
                    <img
                      src="{{ name | asset_url }}&width=164"
                      alt=""
                      width="82"
                      height="82"
                      loading="lazy"
                    >
                  </button>
                {% endfor %}
              {% endif %}
            </div>
            <button type="button" class="dg-nav" data-dg-next aria-label="{{ section.settings.next_label }}">
              <img src="{{ 'dg-icon-next.svg' | asset_url }}" alt="" width="28" height="28">
            </button>
          </div>
        </div>

        <ul class="dg-uvps">
          {% for block in section.blocks %}
            {% if block.type == 'uvp' %}
              <li class="dg-uvp" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 120 | image_tag: alt: '', widths: '80, 120' }}
                {% elsif block.settings.fallback_asset != blank %}
                  <img src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="60" height="60">
                {% endif %}
                <span>{{ block.settings.label }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="dg-bundle__buy" id="dg-buy-box">
        <p class="dg-reviews">
          <img src="{{ 'dg-icon-star.svg' | asset_url }}" alt="" width="83" height="15">
          {% if review_rating != blank %}
            <span class="dg-sr">Rated {{ review_rating }} out of 5 stars.</span>
          {% endif %}
          <span>
            {% if review_count != blank %}
              {{ review_count }} reviews
            {% else %}
              {{ section.settings.review_label }}
            {% endif %}
          </span>
        </p>

        <h1 class="dg-title">{{ heading }}</h1>
        {% if section.settings.subheading != blank %}
          <p class="dg-sub">{{ section.settings.subheading }}</p>
        {% endif %}

        {% render 'dg-price', compare_cents: subtotal, sale_cents: sale, save_cents: discount, save_label: save_label %}

        <div class="dg-bundle__offer">
          <div class="dg-bundle__head">
            <h2 class="dg-bundle__label">
              {{ section.settings.bundle_label }}
              <img src="{{ 'dg-icon-bundle.svg' | asset_url }}" alt="" width="18" height="18">
            </h2>
            <p class="dg-nudge" data-dg-nudge>
              {% if next_min > 0 %}
                {% assign next_diff = next_min | minus: visual_qty %}
                Add {{ next_diff }} more
                {% if next_diff == 1 %}item{% else %}items{% endif %}
                to save {{ next_money }}
              {% elsif discount > 0 %}
                You're saving {{ discount | money_without_trailing_zeros }}
              {% endif %}
            </p>
          </div>

          {% if tier_count > 0 %}
            <div class="dg-progress" style="--dg-tiers: {{ tier_count }}; --dg-fill: {{ fill_pct }}%;">
              <div class="dg-progress__track">
                <div class="dg-progress__fill" data-dg-fill></div>
              </div>
              <ol class="dg-progress__tiers">
                {% for block in section.blocks %}
                  {% if block.type == 'tier' %}
                    <li
                      class="dg-progress__tier{% if visual_qty >= block.settings.min_qty %} is-reached{% endif %}"
                      data-dg-tier
                      data-min="{{ block.settings.min_qty }}"
                      data-discount="{{ block.settings.discount | times: 100 }}"
                      data-label="{{ block.settings.save_label | escape }}"
                      {{ block.shopify_attributes }}
                    >
                      <span class="dg-progress__save">{{ block.settings.save_label }}</span>
                      <span class="dg-progress__mark"></span>
                      <span class="dg-progress__name">{{ block.settings.pack_label }}</span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ol>
            </div>
          {% endif %}

          <div class="dg-items">
            {% for block in section.blocks %}
              {% if block.type == 'item' %}
                {% assign card_product = block.settings.product %}
                {% assign variant_price = 0 %}
                {% assign variant_id = '' %}
                {% if card_product != blank %}
                  {% assign card_variant = card_product.selected_or_first_available_variant %}
                  {% assign variant_price = card_variant.price %}
                  {% assign variant_id = card_variant.id %}
                {% endif %}
                {% assign card_title = block.settings.title %}
                {% if card_title == blank and card_product != blank %}
                  {% assign card_title = card_product.title %}
                {% endif %}
                <article
                  class="dg-card"
                  data-dg-item
                  data-qty="{{ block.settings.quantity }}"
                  data-price="{{ variant_price }}"
                  data-variant="{{ variant_id }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="dg-card__media">
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 392 | image_tag: loading: 'lazy', widths: '160, 196, 320, 392', sizes: '(min-width: 1020px) 196px, 45vw', alt: card_title }}
                    {% elsif card_product != blank and card_product.featured_image != blank %}
                      {{ card_product.featured_image | image_url: width: 392 | image_tag: loading: 'lazy', widths: '160, 196, 320, 392', sizes: '(min-width: 1020px) 196px, 45vw', alt: card_title }}
                    {% elsif block.settings.fallback_asset != blank %}
                      <img
                        src="{{ block.settings.fallback_asset | asset_url }}&width=392"
                        srcset="{{ block.settings.fallback_asset | asset_url }}&width=160 160w, {{ block.settings.fallback_asset | asset_url }}&width=196 196w, {{ block.settings.fallback_asset | asset_url }}&width=320 320w, {{ block.settings.fallback_asset | asset_url }}&width=392 392w"
                        sizes="(min-width: 1020px) 196px, 45vw"
                        alt="{{ card_title | escape }}"
                        width="196"
                        height="91"
                        loading="lazy"
                      >
                    {% endif %}
                  </div>
                  <h3 class="dg-card__title">
                    {{ card_title }}
                    {% if block.settings.subtitle != blank %}
                      <br>{{ block.settings.subtitle }}
                    {% endif %}
                  </h3>
                  {% if block.settings.badge != blank %}
                    <p class="dg-card__badge">
                      <img src="{{ 'dg-icon-badge.svg' | asset_url }}" alt="" width="14" height="14">
                      {{ block.settings.badge }}
                    </p>
                  {% endif %}
                  <div class="dg-qty" data-dg-stepper {% if block.settings.quantity == 0 %}hidden{% endif %}>
                    <button type="button" data-dg-dec aria-label="{{ section.settings.decrease_label }}">
                      <img src="{{ 'dg-icon-minus.svg' | asset_url }}" alt="" width="27" height="27">
                    </button>
                    <span data-dg-qty-label>{{ block.settings.quantity }}</span>
                    <button type="button" data-dg-inc aria-label="{{ section.settings.increase_label }}">
                      <img src="{{ 'dg-icon-plus.svg' | asset_url }}" alt="" width="27" height="27">
                    </button>
                  </div>
                  <button type="button" class="dg-add" data-dg-add {% if block.settings.quantity > 0 %}hidden{% endif %}>
                    {{ section.settings.add_label }}
                    <img src="{{ 'dg-icon-add.svg' | asset_url }}" alt="" width="11" height="11">
                  </button>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% form 'product', product, class: 'product-form dg-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          {% render 'dg-button', label: section.settings.atc_label, price: sale_money, count: priced_qty, can_add: can_add %}
        {% endform %}

        <p class="dg-smaller">
          {{ section.settings.smaller_lead }}
          <a href="{{ smaller_href }}">{{ section.settings.smaller_label }}</a>
          {{ section.settings.smaller_tail }}
        </p>

        <div class="dg-video">
          {% if section.settings.video_heading != blank %}
            <h2 class="dg-video__title">{{ section.settings.video_heading }}</h2>
          {% endif %}
          <div class="dg-video__frame" data-dg-frame>
            <div data-dg-poster>
              {% if section.settings.poster != blank %}
                {{ section.settings.poster | image_url: width: 1194 | image_tag: alt: section.settings.video_heading, widths: '335, 597, 670, 1194', sizes: '(min-width: 1020px) 597px, 100vw', loading: 'lazy' }}
              {% else %}
                <img
                  src="{{ 'dg-video.webp' | asset_url }}&width=1194"
                  srcset="{{ 'dg-video.webp' | asset_url }}&width=335 335w, {{ 'dg-video.webp' | asset_url }}&width=597 597w, {{ 'dg-video.webp' | asset_url }}&width=670 670w, {{ 'dg-video.webp' | asset_url }}&width=1194 1194w"
                  sizes="(min-width: 1020px) 597px, 100vw"
                  alt="{{ section.settings.video_heading | escape }}"
                  width="597"
                  height="336"
                  loading="lazy"
                >
              {% endif %}
            </div>
            {% if section.settings.video != blank %}
              <div hidden>
                {{ section.settings.video | video_tag: controls: true, image_size: '1200x' }}
              </div>
            {% endif %}
            <button
              type="button"
              class="dg-video__play"
              data-dg-play
              aria-label="{{ section.settings.video_heading | escape }}"
              {% if section.settings.video_url != blank %}
                data-video-type="{{ section.settings.video_url.type }}"
                data-video-id="{{ section.settings.video_url.id }}"
              {% endif %}
              {% if section.settings.video == blank and section.settings.video_url == blank %}
                disabled
              {% endif %}
            >
              <img src="{{ 'dg-icon-play.svg' | asset_url }}" alt="" width="49" height="59">
            </button>
          </div>
        </div>

        <div class="dg-acc">
          {% for block in section.blocks %}
            {% if block.type == 'accordion' %}
              <details class="dg-acc__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.title }}</span>
                  <img class="dg-acc__chevron" src="{{ 'dg-icon-chevron.svg' | asset_url }}" alt="" width="20" height="20">
                </summary>
                {% if block.settings.content != blank %}
                  <div class="dg-acc__body">{{ block.settings.content }}</div>
                {% endif %}
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <script type="application/json" data-dg-config>
      {
        "moneyFormat": {{ shop.money_format | json }},
        "cartUrl": {{ routes.cart_url | json }},
        "addUrl": {{ routes.cart_add_url | append: '.js' | json }},
        "atcLabel": {{ section.settings.atc_label | json }}
      }
    </script>
  </div>
{% endif %}

<script src="{{ 'dg-bundle.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "DG bundle product",
  "tag": "section",
  "class": "dg-bundle-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "home_label", "label": "Home label", "default": "Home" },
    { "type": "text", "id": "breadcrumb", "label": "Breadcrumb", "default": "Squeaky Travel Dog Toys | Shop DogGoods™" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fun Dog Toy by DogGoods ™", "info": "Leave blank to use the product title." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Squeaky dog toys with personality, built to last and safe for every chew." },
    { "type": "text", "id": "review_label", "label": "Review label", "default": "9 reviews", "info": "Used until product.metafields.reviews.rating_count is set." },
    { "type": "text", "id": "bundle_label", "label": "Bundle label", "default": "Bundle with" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "[price] - ADD TO CART ([count] ITEMS)", "info": "Tokens: [price] and [count]." },
    { "type": "text", "id": "add_label", "label": "Add item label", "default": "ADD" },
    { "type": "text", "id": "smaller_lead", "label": "Smaller quantity text", "default": "Looking for smaller quantities?" },
    { "type": "text", "id": "smaller_label", "label": "Smaller quantity link", "default": "Find them here." },
    { "type": "text", "id": "smaller_tail", "label": "Smaller quantity tail", "default": "🐾" },
    { "type": "url", "id": "smaller_url", "label": "Smaller quantity link URL" },
    { "type": "text", "id": "video_heading", "label": "Video heading", "default": "Watch the Toys in Action" },
    { "type": "image_picker", "id": "poster", "label": "Video poster" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"] },
    { "type": "text", "id": "prev_label", "label": "Previous label", "default": "Previous image" },
    { "type": "text", "id": "next_label", "label": "Next label", "default": "Next image" },
    { "type": "text", "id": "decrease_label", "label": "Decrease label", "default": "Remove one" },
    { "type": "text", "id": "increase_label", "label": "Increase label", "default": "Add one" }
  ],
  "blocks": [
    {
      "type": "uvp",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Squeaker sound" },
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback icon asset", "default": "dg-icon-squeak.svg" }
      ]
    },
    {
      "type": "tier",
      "name": "Savings tier",
      "settings": [
        { "type": "number", "id": "min_qty", "label": "Minimum items", "default": 4 },
        { "type": "number", "id": "discount", "label": "Discount amount", "default": 15 },
        { "type": "text", "id": "pack_label", "label": "Pack label", "default": "4-pack" },
        { "type": "text", "id": "save_label", "label": "Save label", "default": "Save $15" },
        { "type": "text", "id": "image_badge", "label": "Gallery badge", "default": "4-pack: Save $15" }
      ]
    },
    {
      "type": "item",
      "name": "Bundle item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "default": "Toy" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback image asset" },
        { "type": "range", "id": "quantity", "label": "Starting quantity", "min": 0, "max": 12, "step": 1, "default": 0 },
        { "type": "text", "id": "badge", "label": "Badge" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Description" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "DG bundle product",
      "blocks": [
        { "type": "uvp", "settings": { "label": "Squeaker sound", "fallback_asset": "dg-icon-squeak.svg" } },
        { "type": "uvp", "settings": { "label": "Durability", "fallback_asset": "dg-icon-durable.svg" } },
        { "type": "uvp", "settings": { "label": "Pet-safe", "fallback_asset": "dg-icon-safe.svg" } },
        { "type": "uvp", "settings": { "label": "Fun silhouette", "fallback_asset": "dg-icon-silhouette.svg" } },
        { "type": "tier", "settings": { "min_qty": 4, "discount": 15, "pack_label": "4-pack", "save_label": "Save $15", "image_badge": "4-pack: Save $15" } },
        { "type": "tier", "settings": { "min_qty": 5, "discount": 20, "pack_label": "5-pack", "save_label": "Save $20", "image_badge": "5-pack: Save $20" } },
        { "type": "tier", "settings": { "min_qty": 6, "discount": 30, "pack_label": "6-pack", "save_label": "Save $30", "image_badge": "6-pack: Save $30" } },
        { "type": "item", "settings": { "title": "FuzzyBallz Blue - M", "fallback_asset": "dg-toy-fuzzy-blue.webp", "quantity": 4, "badge": "Best Seller" } },
        { "type": "item", "settings": { "title": "Quacker Jack", "subtitle": "(Small Duck)", "fallback_asset": "dg-toy-quacker.webp" } },
        { "type": "item", "settings": { "title": "FuzzyBallz Green - M", "fallback_asset": "dg-toy-fuzzy-green.webp" } },
        { "type": "item", "settings": { "title": "Prince Hare-y", "subtitle": "(Large Bunny)", "fallback_asset": "dg-toy-hare.webp" } },
        { "type": "item", "settings": { "title": "Mother Clucker", "subtitle": "(Large Chicken)", "fallback_asset": "dg-toy-chicken.webp" } },
        { "type": "item", "settings": { "title": "Xtreme Flyer", "fallback_asset": "dg-toy-flyer.webp" } },
        {
          "type": "accordion",
          "settings": {
            "title": "Description",
            "open": true,
