<section class="about-us">
    <div class="about-us-in">
        <h1>About Us</h1>
        <p>We are a big company of passionate people who are dedicated to creating beautiful and functional products.</p>           
    </div>
    <div class="about-us-img">
        <img
          width="800"
          height="600"
          loading="lazy"
          src="{{ 'nike-company.jpg' | asset_url }}"
          alt="About Us"
        >
    </div>
</section>

<style>
    .about-us {
        background: {{ section.settings.background }};
        color: {{ section.settings.text_color }};
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 24px;
        padding: 24px 16px;
    }

    .about-us-in {
      flex: 1 1 280px;
    }

    .about-us-in h1 {
      margin-top: 0;
      font-size: clamp(1.5rem, 3vw, 2.25rem);
    }

    .about-us-img {
      flex: 1 1 280px;
    }

    .about-us-img img {
      display: block;
      width: 100%;
      border-radius: 12px;
    }

    @media screen and (max-width: 1019px) {
      .about-us {
        flex-direction: column;
        padding: 16px;
        gap: 16px;
      }

      .about-us-in,
      .about-us-img {
        flex: none;
        width: 100%;
      }

      .about-us-in p {
        font-size: 17px;
        line-height: 1.6;
      }
    }
</style>

{% schema %}
{
  "name": "about-us",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "about-us"
    }
  ]
}
{% endschema %}