{% form 'cart', cart %}
  <section class="cart-sec">
    {% if cart.empty? %}
      <div class="empty-cart">
        <p class="empty-cart-text">Your cart is empty :( <br> Let's add some products to it!</p>
        <a class="empty-cart-link" href="/collections/all">Continue shopping</a>
      </div>
    {% else %}
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <img
              width="200"
              height="200"
              loading="lazy"
              src="{{ item.image | image_url: width: 200 }}"
              alt="{{ item.title | escape }}"
            >
            <div class="cart-item-details">
              <h2>{{ item.product.title }}</h2>
              {% unless item.variant.title == 'Default Title' %}
                <p>{{ item.variant.title }}</p>
              {% endunless %}
              <p class="cart-item-price">{{ item.final_line_price | money }}</p>
              <div class="cart-qty-control" data-qty-control>
                <span class="cart-qty-text">Quantity:</span>
                <button type="button" class="cart-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
                <span class="cart-qty-value">{{ item.quantity }}</span>
                <input type="hidden" class="cart-qty-input" name="updates[{{ item.key }}]" value="{{ item.quantity }}" data-line-key="{{ item.key }}">
                <button type="button" class="cart-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
              </div>
              <button type="button" class="cart-remove-item" data-line-key="{{ item.key }}" aria-label="Remove {{ item.product.title | escape }}">
                Remove
              </button>
            </div>
          </div>
          <hr>
        {% endfor %}

        <p class="cart-total">Total: {{ cart.total_price | money }}</p>

        <div class="cart-actions">
          <button type="submit" name="checkout">Checkout</button>
        </div>
      </div>
    {% endif %}
  </section> 
{% endform %}

{% render 'cart-upsell' %}

<style>
  .cart-sec {
    background-color: rgb(226, 226, 226);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 40px 20px 16px;
    box-sizing: border-box;
  }

  .empty-cart,
  .cart-items {
    width: 100%;
    max-width: 640px;
  }

  .empty-cart-text {
    text-align: center;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .empty-cart {
    text-align: center;
  }

  .empty-cart-link {
    display: inline-block;
    text-decoration: none;
    color: #fff;
    background-color: #000;
    font-size: 16px;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 8px;
    margin-bottom: 20px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .empty-cart-link:hover {
    background-color: #333;
    transform: scale(1.02);
  }

  .cart-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .cart-item img {
    border-radius: 8px;
    object-fit: cover;
  }

  .cart-item-details h2 {
    margin: 0 0 8px;
  }

  .cart-qty-control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    margin: 8px 0;
  }

  .cart-qty-btn {
    width: 28px;
    height: 28px;
    padding: 0;
    font-size: 18px;
    line-height: 1;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
  }

  .cart-qty-btn:hover {
    background: #f0f0f0;
  }

  .cart-qty-value {
    min-width: 20px;
    text-align: center;
    font-weight: 600;
  }

  .cart-qty-input {
    display: none;
  }

  .cart-total {
    font-size: 24px;
    font-weight: 600;
    margin: 24px 0;
  }

  .cart-actions {
    display: flex;
    gap: 12px;
  }

  .cart-actions button {
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
  }

  .cart-actions button[name='checkout'] {
    background-color: #000;
    color: #fff;
  }

  .cart-remove-item {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    text-decoration: underline;
    color: #000;
    cursor: pointer;
  }

  .cart-remove-item:hover {
    color: rgb(161, 26, 26);
  }

</style>

<script>
  (function () {
    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    if (root.charAt(root.length - 1) !== '/') root += '/';
    var cartUpdateUrl = root + 'cart/update.js';
    var moneyFormat = {{ shop.money_format | json }};
    var currencyCode = {{ cart.currency.iso_code | json }};

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return (cents / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: currencyCode || 'USD'
      });
    }

    function updateCartDisplay(cart) {
      var totalEl = document.querySelector('.cart-total');
      if (totalEl) {
        totalEl.textContent = 'Total: ' + formatMoney(cart.total_price);
      }

      cart.items.forEach(function (item) {
        var input = document.querySelector('.cart-qty-input[data-line-key="' + item.key + '"]');
        if (!input) return;

        var priceEl = input.closest('.cart-item-details').querySelector('.cart-item-price');
        if (priceEl) {
          priceEl.textContent = formatMoney(item.final_line_price);
        }
      });
    }

    function updateCartLine(lineKey, quantity) {
      var updates = {};
      updates[lineKey] = quantity;

      return fetch(cartUpdateUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ updates: updates })
      }).then(function (response) {
        if (!response.ok) throw new Error('Cart update failed');
        return response.json();
      });
    }

    function removeCartItemFromDom(button, cart) {
      var cartItem = button.closest('.cart-item');
      if (cartItem) {
        var divider = cartItem.nextElementSibling;
        cartItem.remove();
        if (divider && divider.tagName === 'HR') divider.remove();
      }

      updateCartDisplay(cart);

      if (cart.item_count === 0) {
        var cartItems = document.querySelector('.cart-items');
        if (cartItems) {
          cartItems.outerHTML =
            '<div class="empty-cart">' +
              '<p>Your cart is empty</p>' +
              '<a href="/collections/all">Continue shopping</a>' +
            '</div>';
        }
      }
    }

    function submitUpdate(control, nextQty) {
      var input = control.querySelector('.cart-qty-input');
      var display = control.querySelector('.cart-qty-value');
      var lineKey = input.getAttribute('data-line-key');

      input.value = nextQty;
      display.textContent = nextQty;

      updateCartLine(lineKey, nextQty)
        .then(function (cart) {
          if (nextQty === 0) {
            var removeBtn = control.closest('.cart-item-details').querySelector('.cart-remove-item');
            removeCartItemFromDom(removeBtn || control, cart);
            return;
          }

          updateCartDisplay(cart);
        })
        .catch(function () {
          window.location.reload();
        });
    }

    document.querySelectorAll('.cart-sec [data-qty-control]').forEach(function (control) {
      var input = control.querySelector('.cart-qty-input');

      control.querySelector('[data-qty-minus]').addEventListener('click', function () {
        var qty = parseInt(input.value, 10) || 0;
        if (qty > 0) submitUpdate(control, qty - 1);
      });

      control.querySelector('[data-qty-plus]').addEventListener('click', function () {
        var qty = parseInt(input.value, 10) || 0;
        submitUpdate(control, qty + 1);
      });
    });

    document.querySelectorAll('.cart-sec .cart-remove-item[data-line-key]').forEach(function (button) {
      button.addEventListener('click', function () {
        var lineKey = button.getAttribute('data-line-key');
        if (!lineKey) return;

        button.disabled = true;

        updateCartLine(lineKey, 0)
          .then(function (cart) {
            removeCartItemFromDom(button, cart);
          })
          .catch(function () {
            button.disabled = false;
          });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "cart",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "cart"
    }
  ]
}
{% endschema %}
